# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Telegram ID, которым разрешено писать боту (через запятую). Свой ID можно узнать командой /id
ALLOWED_USER_IDS=

# Вебхук регулярной задачи Grok Bot (копируется из панели routine)
WEBHOOK_URL=
WEBHOOK_KEY=

# Как передавать ключ: заголовок и схема. По умолчанию: "Authorization: Bearer <WEBHOOK_KEY>"
# Если ключ нужно передавать как есть, без схемы, укажите WEBHOOK_AUTH_SCHEME=none
WEBHOOK_AUTH_HEADER=Authorization
WEBHOOK_AUTH_SCHEME=Bearer
WEBHOOK_TIMEOUT_SECONDS=15
WEBHOOK_MAX_ATTEMPTS=3

# Как часто проверять папку runtime/outbox (секунды)
OUTBOX_POLL_SECONDS=2

# Показывать «печатает…», пока задача в работе (true/false)
TYPING_INDICATOR=true

# Через сколько минут без ответа предупредить, что задача ещё в работе или могла зависнуть. 0 — выключить
TASK_TIMEOUT_MINUTES=15

# Сообщения, пришедшие с паузой меньше N секунд (альбом, фото + текст), склеиваются в одну задачу. 0 — выключить
MESSAGE_DEBOUNCE_SECONDS=2.5

# Максимальный размер вложения для скачивания, МБ (лимит Bot API — 20)
MAX_DOWNLOAD_MB=20

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
